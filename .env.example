# =============================================================
# SOLUÇÕES 2M CLIMATIZAÇÃO — Variáveis de Ambiente
# =============================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite o arquivo .env.local no repositório.
# Veja docs/manual-cliente.md para instruções em linguagem leiga.
# =============================================================

# -------------------------------------------------------------
# BANCO DE DADOS
# -------------------------------------------------------------
# Dev (SQLite local): file:./dev.db
# Prod (Vercel Postgres): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=file:./dev.db

# -------------------------------------------------------------
# WHATSAPP
# -------------------------------------------------------------
# Número no formato internacional, apenas dígitos: 55 + DDD + número
# Exemplo: 5571999999999 (Salvador-BA)
WHATSAPP_NUMBER=5571999999999

# Email do técnico que receberá notificações de novos leads
NOTIFICATION_EMAIL=contato@solucoes2m.com.br

# -------------------------------------------------------------
# FACEBOOK ADS
# -------------------------------------------------------------
# Obtido no Facebook Ads Manager > Pixels
NEXT_PUBLIC_FB_PIXEL_ID=PIXEL_ID_AQUI

# Obtido no Facebook Events Manager > Configurações da API de Conversões
FB_CONVERSIONS_API_TOKEN=TOKEN_AQUI

# -------------------------------------------------------------
# EMAIL (Resend)
# -------------------------------------------------------------
# Obtido em resend.com após criar conta e verificar domínio
RESEND_API_KEY=re_XXXXX

# -------------------------------------------------------------
# SITE
# -------------------------------------------------------------
# URL pública do site (sem barra no final)
# Em dev: http://localhost:3000
# Em prod: https://solucoes2m.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CNPJ da empresa (placeholder — cliente preenche)
CNPJ=00.000.000/0001-00

# -------------------------------------------------------------
# ANALYTICS (Vercel Analytics)
# -------------------------------------------------------------
# Gerado automaticamente pela Vercel ao habilitar Analytics no dashboard
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=xxxxx

# -------------------------------------------------------------
# SENTRY (Error tracking — setup inicial, ativo em v2)
# -------------------------------------------------------------
# Obtido em sentry.io ao criar o projeto
NEXT_PUBLIC_SENTRY_DSN=https://XXXXX@oXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_AUTH_TOKEN=sntrys_XXXXX
